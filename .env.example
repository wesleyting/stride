# Public URL of this Stride deployment. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Dashboard → Connect, or Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional bot protection for sign-in, sign-up, password reset, and guest access.
# Add the public site key here, then enable Turnstile in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: credentials for a dedicated local/test Supabase account. The
# authenticated Playwright flow is skipped when these are not set.
E2E_EMAIL=
E2E_PASSWORD=

# Set to 1 only when the configured Supabase project permits anonymous users.
E2E_GUEST=
